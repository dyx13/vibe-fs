<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>application-composition</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>authority-runtime-surface</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>interaction-authority</WanxiangshuSemanticOwner>
