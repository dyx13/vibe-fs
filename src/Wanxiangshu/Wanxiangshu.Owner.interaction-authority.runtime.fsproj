    <ProjectReference Include="Wanxiangshu.Owner.host-boundary.host-digest.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.host-boundary.host-message-codec.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.host-boundary.opencode-host-sessionquiescencegate.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.interaction-authority.interaction-authority-fact.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.interaction-authority.interaction-authority-fold.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.interaction-repair-completedturn.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.interaction-authority.interaction-authority-identityseed.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.interaction-authority.opencode-host-chatadmission-intent.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.participant-identity.participant-persona.fsproj"/>
    <Compile Include="Interaction/Authority/Surface.fsi"/>
    <Compile Include="Interaction/Authority/Surface.fs"/>
    <Compile Include="Interaction/Authority/RuntimeSurface.fsi"/>
    <Compile Include="Interaction/Authority/RuntimeSurface.fs"/>
    <Compile Include="Interaction/Repair/CompletedTurnSurface.fsi"/>
    <Compile Include="Interaction/Repair/CompletedTurnSurface.fs"/>
    <Compile Include="OpenCode/Host/ChatAdmission/IntentSurface.fsi"/>
    <Compile Include="OpenCode/Host/ChatAdmission/IntentSurface.fs"/>
    <Compile Include="OpenCode/Host/TerminalPolicySurface.fsi"/>
    <Compile Include="OpenCode/Host/TerminalPolicySurface.fs"/>
  </ItemGroup>
</Project>
