<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>host</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>host-message-codec</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>host-boundary</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>host-message-codec</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-canonical-json.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.provider-projection.provider-message-evidence.fsproj"/>
    <Compile Include="OpenCode/Codec/HostMessageCodec.fsi"/>
    <Compile Include="OpenCode/Codec/HostMessageCodec.fs"/>
  </ItemGroup>
</Project>
