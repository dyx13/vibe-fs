<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>application-composition</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>git-hook-sync</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>durable-convergence</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>git-hook-sync</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.change-integration.git-gateway.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-convergence.eventstore-process-log.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-convergence.eventstore-sync-runtime.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.eventstore-git-contract.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.eventstore-git-runtime.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.runtime-platform.digest.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.time-capability.process-node-timing-adapter.fsproj"/>
    <Compile Include="Git/Hook/Sync.fsi"/>
    <Compile Include="Git/Hook/Sync.fs"/>
    <Compile Include="Git/Hook/Dispatcher.fsi"/>
    <Compile Include="Git/Hook/Dispatcher.fs"/>
    <Compile Include="Git/Hook/Surface.fsi"/>
    <Compile Include="Git/Hook/Surface.fs"/>
  </ItemGroup>
</Project>
