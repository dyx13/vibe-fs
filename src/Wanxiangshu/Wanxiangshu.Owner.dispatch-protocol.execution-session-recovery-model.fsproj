<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>dispatch</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>dispatch-model-contract</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>dispatch-protocol</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>dispatch-model-contract</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-outcome.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.execution-failure-policy.execution-failure-model.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.host-boundary.host-message-contract.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.host-boundary.host-opencode-types.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.participant-identity.foundation-roles.fsproj"/>
    <Compile Include="Execution/Session/Recovery/Model.fsi"/>
    <Compile Include="Execution/Session/Recovery/Model.fs"/>
    <Compile Include="Composition/Turn/Program.fsi"/>
    <Compile Include="Composition/Turn/Program.fs"/>
    <Compile Include="Composition/Turn/Observation.fsi"/>
    <Compile Include="Composition/Turn/Observation.fs"/>
  </ItemGroup>
</Project>
